{
  "name": "inkling",
  "private": true,
  "version": "0.10.1",
  "description": "Write a diagram as text, get a drawing that looks hand-made.",
  "license": "MIT",
  "author": "Shivaraj Bakale",
  "homepage": "https://shivarajbakale.github.io/inkling/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivarajbakale/inkling.git"
  },
  "keywords": [
    "diagram",
    "hand-drawn",
    "sketch",
    "svg",
    "mermaid-alternative",
    "rough",
    "markdown",
    "react"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "vite build --mode single",
    "typecheck": "tsc -b",
    "build:lib": "rm -rf dist-lib && vite build --mode lib && vite build --mode lib-node && vite build --mode lib-react && vite build --mode lib-remark && vite build --mode lib-markdown-it && tsc -p tsconfig.lib.json",
    "build:all": "npm run build:lib && npm run build:single && node scripts/artifact.mjs",
    "vendor": "node scripts/vendor.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "UPDATE_GOLDEN=1 vitest run tests/golden.test.ts",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "metrics": "node scripts/font-metrics.mjs",
    "check": "tsc -b && vitest run && npm run build:lib",
    "sites": "node examples/sites/build-all.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^1.1.4",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@tabler/icons-react": "^3.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "elkjs": "^0.12.1",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.0",
    "linkedom": "^0.18.15",
    "markdown-it": "^15.0.3",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "~7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "module": "./dist-lib/inkling.js",
  "types": "./dist-lib/types/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/lib.d.ts",
      "import": "./dist-lib/inkling.js"
    },
    "./iife": "./dist-lib/inkling.iife.js",
    "./react": {
      "types": "./dist-lib/inkling-react.d.ts",
      "import": "./dist-lib/inkling-react.js"
    },
    "./remark": {
      "types": "./dist-lib/inkling-remark.d.ts",
      "import": "./dist-lib/inkling-remark.js"
    },
    "./markdown-it": {
      "types": "./dist-lib/inkling-markdown-it.d.ts",
      "import": "./dist-lib/inkling-markdown-it.js"
    },
    "./node": {
      "types": "./dist-lib/inkling-node.d.ts",
      "import": "./dist-lib/inkling-node.js"
    }
  },
  "files": [
    "dist-lib",
    "bin"
  ],
  "bin": {
    "inkling": "bin/inkling.mjs"
  }
}
