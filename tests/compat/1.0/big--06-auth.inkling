title "Signing in"
direction down
seed 9

user: person "User"
login: box "Login page"
method: diamond "Method?"
pw: box "Password form"
sso: box "SSO button"
magic: box "Magic link"
idp: cloud "Identity provider"
check: box "Check password"
locked: diamond "Locked?"
lockmsg: sticky "Try later"
mfa: diamond "MFA on?"
otp: box "Enter code"
webauthn: box "Security key"
verify: box "Verify factor"
ok: diamond "Valid?"
fail: box "Count failure"
email: box "Send email"
inbox: round "Inbox"
token: box "Check token"
expired: diamond "Expired?"
risk: box "Risk score"
step: diamond "Risky?"
session: box "Create session"
refresh: box "Refresh token"
audit: db "Audit log"
home: round "Home"
consent: box "Consent screen"
link: box "Link account"

user -> login -> method
method -> pw : "password"
method -> sso : "sso"
method -> magic : "email"
pw -> check -> locked
locked -> lockmsg : "yes"
locked -> risk : "no"
risk -> step
step -> mfa : "yes"
step -> session : "no"
mfa -> otp : "code"
mfa -> webauthn : "key"
otp -> verify
webauthn -> verify
verify -> ok
ok -> session : "yes"
ok -> fail : "no"
fail -> audit
fail -> login
sso -> idp -> consent -> link -> risk
magic -> email -> inbox -> token -> expired
expired -> login : "yes"
expired -> risk : "no"
session -> refresh
session -> audit
session -> home
